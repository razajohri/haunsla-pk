FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haunsla
# Or use Supabase:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
CORS_ORIGINS=*
SCRAPE_INTERVAL_MINUTES=60
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@haunsla.pk
SEED_DEMO_JOBS=1

# JobSpy pipeline (remotejobscanada.ca playbook)
USE_PIPELINE_STORE=1
JOB_CACHE_TTL_SECONDS=900
SCRAPE_HIRING_CAFE=0
HIRING_CAFE_MAX_PAGES=5
HIRING_CAFE_MAX_JOBS=200
SCRAPE_GOOGLE=1
SCRAPE_INDEED_INTL=1
SCRAPE_BAYT_NAUKRI=0
SCRAPE_REPSTACK=1
SCRAPE_CAREER_BOARDS=1
# Direct company career pages (config/career_pages.json) — ATS detect + HTML
SCRAPE_CAREER_PAGES=1
# 0 = all companies in career_pages.json
CAREER_PAGE_LIMIT=0
SCRAPE_ATS_BULK=1
SCRAPE_REMOTE_BOARDS=1
SCRAPE_INDEED=1
SCRAPE_LINKEDIN=1
# Keep only worldwide / any-country remote (drop Remote-US etc.)
WORLDWIDE_ONLY=0
# Extra Indeed/LinkedIn/Google terms for internships + junior/entry roles
SCRAPE_ENTRY_LEVEL=1
# Lahore / Karachi / Islamabad employers + banks (see config/pakistan_companies.json)
SCRAPE_PAKISTAN_COMPANIES=1
SCRAPE_PAKISTAN_GOOGLE=1
ALLOW_PAKISTAN_LOCAL=1
# 0 = all companies in JSON; raise for full bank/tech coverage
PK_COMPANY_LIMIT=0
HAUNSLA_SCRAPE_QUICK=0
SKIP_LINK_VALIDATE=0
VALIDATE_WORKERS=12
# Smaller local smoke runs:
# HAUNSLA_SCRAPE_QUICK=1
# PK_COMPANY_LIMIT=20
# INDEED_RESULTS_PER_QUERY=50
# ATS_RESULTS_WANTED=200
# See backend/SCRAPERS.md for the full scraper runbook.
